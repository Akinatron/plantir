# Client-safe Expo public values. These are bundled into the app.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Local CLI/deployment helpers only. Never expose these through EXPO_PUBLIC_*.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=plantir-mobile
