# ===========================================
# Plantir — variables de entorno
# ===========================================
# Copia este archivo a `.env` (local) o configúralo en tu CI / hosting.
# NUNCA commitees un `.env` real con secretos.

# -----------------------------------------
# Cliente (Expo, prefijo EXPO_PUBLIC_)
# -----------------------------------------

# URL del proyecto Supabase.
# - Local: http://localhost:54321 (tras `supabase start`)
# - Staging/Prod: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Anon key (pública, protegida por RLS). Se encuentra en
# Supabase Dashboard > Settings > API > Project API keys.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------
# Edge Functions (Deno, prefijo SUPABASE_)
# -----------------------------------------
# Estas se configuran automáticamente al hacer `supabase functions deploy`,
# pero para `supabase functions serve` local se pueden inyectar vía
# `supabase/.env.local` o variables del shell.

# URL de tu proyecto Supabase.
SUPABASE_URL=

# Service role key (SECRETO, solo server-side). NUNCA exponer al cliente.
# La encuentras en Supabase Dashboard > Settings > API > Project API keys.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key (la misma que en el cliente).
SUPABASE_ANON_KEY=

# URL pública de la app web (para construir invite links con dominio web).
PUBLIC_WEB_URL=https://plantir.app
